    "vps",
    "ssh"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "@types/ssh2": "^1.15.6",
    "ssh2": "^1.17.0",
    "typescript": "^5.9.3",
    "undici": "^7.30.2",
    "zod": "^4.6.7"
  }
