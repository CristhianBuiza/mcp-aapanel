# Panel address: protocol, host and port only (no security entry path)
AAPANEL_URL=https://YOUR_SERVER_IP:7800
# Panel > Settings > API interface > interface key
AAPANEL_API_KEY=
# aaPanel ships with a self-signed certificate; set to false in that case
AAPANEL_VERIFY_TLS=false
# true = only read tools are exposed (no changes to the server)
AAPANEL_READ_ONLY=false
AAPANEL_TIMEOUT_MS=60000

# VPS SSH access (fill in one of VPS_SSH_KEY or VPS_SSH_PASSWORD)
VPS_SSH_HOST=YOUR_SERVER_IP
VPS_SSH_PORT=22
VPS_SSH_USER=root
# Path to the private key file, e.g. ~/.ssh/id_ed25519_vps
VPS_SSH_KEY=
VPS_SSH_PASSWORD=
# Refuse to connect if the server host key differs (ssh-keyscan HOST | ssh-keygen -lf -)
VPS_SSH_HOST_FINGERPRINT=
