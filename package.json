{
  "name": "aapanel-vps",
  "version": "1.1.0",
  "description": "MCP server to manage an aaPanel server through its API and the VPS over SSH",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "aapanel-vps": "dist/index.js"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    ".env.example",
    "targets.example.json",
    "README.md",
    "LICENSE",
    "mcp.json",
    ".cursor-plugin",
    "assets"
  ],
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "setup": "node dist/index.js setup",
    "start": "node dist/index.js",
    "test": "tsc && node test/e2e.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CristhianBuiza/mcp-aapanel.git"
  },
  "homepage": "https://github.com/CristhianBuiza/mcp-aapanel#readme",
  "bugs": "https://github.com/CristhianBuiza/mcp-aapanel/issues",
